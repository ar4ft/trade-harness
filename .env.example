TRADING_BACKEND=decision
TRADING_DB=decisions.sqlite
TRADING_PAPER_DB=paper.sqlite
# TRADING_DECISION_MODEL=artifacts/decision_model.json
# TRADING_RISK_CONFIG=your-risk-config.json
# Optional API bearer authentication:
# TRADING_API_KEY=change-me
# Optional trained language adapter override:
# TRADING_LORA_PATH=artifacts/my-trading-lora
# Dedicated merged-adapter inference through Mozilla llamafile:
LLAMAFILE_BASE_URL=http://127.0.0.1:8080
LLAMAFILE_API_KEY=
# Generic instruction models with OpenAI-compatible JSON chat:
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-model-id
LLM_API_KEY=
# Optional authenticated Nimble service:
NIMBLE_BASE_URL=https://bespokelabs--nimble-sglang-nimble.us-west.modal.direct
NIMBLE_MODEL=nimble-latest
NIMBLE_API_KEY=
NIMBLE_MODAL_KEY=
NIMBLE_MODAL_SECRET=
# Managed launcher checks for signed updates at startup (at most once/day):
TRADING_AUTO_UPDATE=1
# TRADING_UPDATE_HOME=/your/user-owned/managed-directory
# Preserve optional Python LoRA inference/training dependencies in managed upgrades:
# TRADING_UPDATE_EXTRAS=llm-train

# Optional TimesFM 3.0 historical research (pip install -e ".[timesfm]"):
# TRADING_BACKEND=timesfm
# TRADING_TIMESFM_DEVICE=cpu
# TRADING_TIMESFM_CONTEXT=512
# TRADING_TIMESFM_OFFLINE=1
# TRADING_UPDATE_EXTRAS=timesfm

# Combined forecasts + strategies + numerical decision model:
# TRADING_BACKEND=hybrid
# TRADING_HYBRID_MODEL=src/trade_harness/assets/hybrid_model.json

# Shared-evidence language confirmation of the numerical hybrid:
# TRADING_BACKEND=orchestrator
# TRADING_ORCHESTRATOR_REVIEWERS=local-llm
# TRADING_ORCHESTRATOR_CONFIG=examples/orchestrator.json
# TRADING_UPDATE_EXTRAS=orchestrator
# Optional tuned model (not activated automatically):
# TRADING_HYBRID_MODEL=src/trade_harness/assets/tuned_hybrid_model.json
